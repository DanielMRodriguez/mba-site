---
interface Props {
  name: string;
  size?: string | number;
  class?: string;
  color?: string;
  title?: string;
}

const { name } = Astro.props as Props;

---
<span>
  <img src={`/images/icon/${name}.svg`} alt={name} />
</span>


<style>
span{
  color:white;
}

img{
  width: 90px;
  height: 90px;
}
</style>