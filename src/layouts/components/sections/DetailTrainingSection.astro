---
import CardOutlayerTrainingS from "@/layouts/components/CardOutlayerTrainingS.astro";
const { title, cards } = Astro.props;
---

<section class="eyerlin-training-page">
  <div class="container">
    <div class="row">
      <div class="col-12 mb-5">
        <h2 class="text-white">{title}</h2>
      </div>

      <div class="col-12">
        <div class="cards-container">
          {
            cards.map((card) => (
              <div class="card-container">
                <CardOutlayerTrainingS
                  title={card.title}
                  description={card.description}
                  cta={card.cta}
                  label={card.label}
                />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  section {
    background-color: #27252a;
  }

  .eyerlin-training-page {
    overflow: hidden;
    padding-top: 40px;
    padding-bottom: 150px;
  }
  .cards-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 70px;
    row-gap: 130px;
    padding-bottom: 50px;
  }

  .cards-container {
    
  }

  @media (max-width: 768px) {
    .cards-container {
      grid-template-columns: repeat(1, 1fr);
      margin-left: 20px;
      margin-right: 20px;
      row-gap: 40px;
    }

    .card-container {
      margin-bottom: 70px;
    }

    .eyerlin-training-page{
      padding-bottom: 20px;
    }

    .cards-container{
      margin-bottom: 0px;
    }
  }
</style>
