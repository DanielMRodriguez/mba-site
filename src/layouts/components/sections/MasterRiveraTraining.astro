---

---

<section class="master-rivera-training">
  <div class="background-image">
    <div class="background-image__overlay"></div>
    <div class="background-image__img"></div>
  </div>
  <div class="master-rivera-training-content">
    <div class="master-rivera-training-body">
      <h2 class="text-white mb-6 animate-slide-in-up">Master María Rivera</h2>

      <p class="text-white text-xl mb-5 animate-slide-in-up" data-delay="0.2s">
        Make microblading, powder brows and lip blushing part of your success!
        Learn the latest semi-permanent makeup techniques at Modern Beauty
        Academy's world-class training program.
      </p>
      <p class="text-white text-xl mb-5 animate-slide-in-up" data-delay="0.4s">
        In a few days you can go from basics to mastering advanced techniques
        and getting certified.
      </p>
      <p class="text-white text-xl mb-5 animate-slide-in-up" data-delay="0.6s">
        We also offer online learning courses that allow you to receive the same
        high-quality training experience from the comfort of your own home.
      </p>
    </div>

    <div class="master-rivera-training-image">
      <img
        src="/images/training/mastermariarivera.webp"
        alt="Master Rivera Training"
        class="animate-slide-in-up"
      />
    </div>
  </div>
</section>

<style>
  .master-rivera-training {
    position: relative;
    overflow: hidden;
  }

  .background-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
  }

  .background-image__img {
    position: absolute;
    background-image: url("/images/training/24975.png");
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .background-image__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
    background-color: rgba(78, 78, 78, 0.8);
  }

  .master-rivera-training-content {
    position: relative;
    z-index: 4;
    display: flex;
  }

  .master-rivera-training-body {
    padding: 50px 100px 50px 50px;
  }

  .master-rivera-training-image {
    width:500px;
    min-width: 400px;
  }

  .master-rivera-training-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .master-rivera-training-image {
      max-width: 100%;
    }

    .master-rivera-training-content {
      flex-direction: column;
      gap: 50px;
    }

    .master-rivera-training-body {
      order: 2;
      padding: 20px;
    }

    .master-rivera-training-image {
      order: 1;
    }
  }
</style>
