  title: "Why Choose Modern Beauty Academy?",
  subtitle:
    "For best results and long-lasting effects, follow these aftercare tips:",
  list: [
    "✱ <b>Expert Instructors:</b> Learn from industry-leading professionals with years of experience",
    "✱ <b>Hands-On Practice:</b> Gain real-world skills through guided training with live models",
    "✱ <b>Comprehensive Curriculum:</b> Master mapping, color theory, and advanced application techniques",
    "✱ <b>Business Support:</b> Get marketing tips, client management, and setup guidance for success",
    "✱ <b>Recognized Certification:</b> Earn credentials that boost your credibility and career opportunities",
  ],
};

const detail_training_section = {
