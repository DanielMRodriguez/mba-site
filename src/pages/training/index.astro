---
import Base from "@/layouts/Base.astro";
import Hero from "@/layouts/components/Hero.astro";
import TrainingInfo from "@/layouts/components/sections/TrainingInfo.astro";
import DetailTrainingSection from "@/layouts/components/sections/DetailTrainingSection.astro";
